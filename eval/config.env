# VaultPack eval config — consumed by ../bugforge/eval/verify_poc.sh

# shellcheck shell=bash

SRC_DIR="$REPO/src"
FUZZ_BRIDGE_SRC="$REPO/fuzz/fuzz_bridge.c"
FUZZ_BRIDGE_H="$REPO/fuzz/fuzz_bridge.h"

CORE_SOURCES=(
  "$SRC_DIR/archive.c"
  "$SRC_DIR/section.c"
  "$SRC_DIR/metadata.c"
  "$SRC_DIR/index.c"
  "$SRC_DIR/extract.c"
  "$SRC_DIR/util.c"
  "$SRC_DIR/error.c"
  "$SRC_DIR/stream.c"
  "$SRC_DIR/buffer.c"
  "$SRC_DIR/crc32.c"
  "$SRC_DIR/writer.c"
  "$SRC_DIR/manifest.c"
  "$SRC_DIR/manifest_apply.c"
  "$SRC_DIR/codec.c"
  "$SRC_DIR/validate.c"
)

declare -A HARNESS_CALLS
HARNESS_CALLS[archive_fuzzer]='vp_bridge_archive(data, size)'
HARNESS_CALLS[section_fuzzer]='vp_bridge_section(data, size)'
HARNESS_CALLS[metadata_fuzzer]='vp_bridge_metadata(data, size)'
HARNESS_CALLS[index_fuzzer]='vp_bridge_index(data, size)'
HARNESS_CALLS[extract_fuzzer]='vp_bridge_extract(data, size)'
HARNESS_CALLS[stream_fuzzer]='vp_bridge_stream(data, size)'
HARNESS_CALLS[manifest_fuzzer]='vp_bridge_manifest(data, size)'
HARNESS_CALLS[codec_fuzzer]='vp_bridge_codec(data, size)'
HARNESS_CALLS[writer_fuzzer]='vp_bridge_writer(data, size)'
HARNESS_CALLS[validate_fuzzer]='vp_bridge_validate(data, size)'
