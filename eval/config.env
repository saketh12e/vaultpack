# VaultPack eval config — consumed by the upstream scoring script

# shellcheck shell=bash

SRC_DIR="$REPO/src"
FUZZ_BRIDGE_SRC="$REPO/fuzz/fuzz_bridge.c"
FUZZ_BRIDGE_H="$REPO/fuzz/fuzz_bridge.h"

CORE_SOURCES=(
  "$SRC_DIR/archive.c"
  "$SRC_DIR/section.c"
  "$SRC_DIR/metadata.c"
  "$SRC_DIR/index.c"
  "$SRC_DIR/extract.c"
  "$SRC_DIR/util.c"
  "$SRC_DIR/error.c"
  "$SRC_DIR/stream.c"
  "$SRC_DIR/buffer.c"
  "$SRC_DIR/crc32.c"
  "$SRC_DIR/writer.c"
  "$SRC_DIR/manifest.c"
  "$SRC_DIR/manifest_apply.c"
  "$SRC_DIR/codec.c"
  "$SRC_DIR/validate.c"
  "$SRC_DIR/decompress_lz4.c"
  "$SRC_DIR/decompress_hc.c"
  "$SRC_DIR/section_pipeline.c"
  "$SRC_DIR/checksum_stream.c"
  "$SRC_DIR/pack_ctx.c"
  "$SRC_DIR/chunk_assembler.c"
  "$SRC_DIR/dir_emit.c"
  "$SRC_DIR/pack_abort.c"
  "$SRC_DIR/range_io.c"
  "$SRC_DIR/section_cache.c"
  "$SRC_DIR/archive_view.c"
  "$SRC_DIR/prefetch.c"
  "$SRC_DIR/cache_pin.c"
  "$SRC_DIR/interval_engine.c"
  "$SRC_DIR/archive_merge.c"
  "$SRC_DIR/archive_repair.c"
  "$SRC_DIR/archive_diff.c"
  "$SRC_DIR/offset_remap.c"
  "$SRC_DIR/meta_schema.c"
  "$SRC_DIR/meta_compose.c"
  "$SRC_DIR/index_sort.c"
  "$SRC_DIR/index_lookup.c"
  "$SRC_DIR/index_compact.c"
)

declare -A HARNESS_CALLS
HARNESS_CALLS[archive_fuzzer]='vp_bridge_archive(data, size)'
HARNESS_CALLS[section_fuzzer]='vp_bridge_section(data, size)'
HARNESS_CALLS[metadata_fuzzer]='vp_bridge_metadata(data, size)'
HARNESS_CALLS[index_fuzzer]='vp_bridge_index(data, size)'
HARNESS_CALLS[extract_fuzzer]='vp_bridge_extract(data, size)'
HARNESS_CALLS[stream_fuzzer]='vp_bridge_stream(data, size)'
HARNESS_CALLS[manifest_fuzzer]='vp_bridge_manifest(data, size)'
HARNESS_CALLS[codec_fuzzer]='vp_bridge_codec(data, size)'
HARNESS_CALLS[writer_fuzzer]='vp_bridge_writer(data, size)'
HARNESS_CALLS[validate_fuzzer]='vp_bridge_validate(data, size)'
HARNESS_CALLS[pipeline_fuzzer]='vp_bridge_pipeline(data, size)'
HARNESS_CALLS[pack_fuzzer]='vp_bridge_pack(data, size)'
HARNESS_CALLS[cache_fuzzer]='vp_bridge_cache(data, size)'
HARNESS_CALLS[merge_fuzzer]='vp_bridge_merge(data, size)'
HARNESS_CALLS[repair_fuzzer]='vp_bridge_repair(data, size)'
HARNESS_CALLS[schema_fuzzer]='vp_bridge_schema(data, size)'
HARNESS_CALLS[index2_fuzzer]='vp_bridge_index2(data, size)'
HARNESS_CALLS[range_fuzzer]='vp_bridge_range(data, size)'
HARNESS_CALLS[diff_fuzzer]='vp_bridge_diff(data, size)'
HARNESS_CALLS[compose_fuzzer]='vp_bridge_compose(data, size)'
